LLM_PROVIDER=alibaba
LLM_API_KEY_ENV=LLM_API_KEY
LLM_API_KEY=your-llm-api-key
LLM_MODEL=qwen3.6-flash-2026-04-16
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_COMPATIBILITY_MODE=openai_compatible_chat

EMBEDDING_PROVIDER=alibaba
EMBEDDING_API_KEY_ENV=EMBEDDING_API_KEY
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_COMPATIBILITY_MODE=openai_compatible
EMBEDDINGS_ENABLED=1

VECTOR_BACKEND=auto
VECTOR_BACKEND_FALLBACK=sqlite_ann
RETRIEVAL_RERANKER_ENABLED=1
RETRIEVAL_RERANKER_BACKEND=auto
RETRIEVAL_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVAL_RERANKER_DEVICE=cpu
RETRIEVAL_RERANKER_BATCH_SIZE=8
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_COLLECTION_PREFIX=repo_autonomy_
PGVECTOR_DSN=
PGVECTOR_TABLE=repo_autonomy_vectors

GITHUB_ACTIONS_ENABLED=1
GITHUB_TOKEN=your-github-token
GITHUB_REPOSITORY=second196/simple_repo
GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2022-11-28

GITLAB_CI_ENABLED=0
GITLAB_TOKEN=   
GITLAB_API_URL=https://gitlab.com/api/v4
GITLAB_PROJECT_ID=

JENKINS_ENABLED=1
JENKINS_USERNAME=admin
JENKINS_TOKEN=your-jenkins-token
JENKINS_BASE_URL=http://localhost:32768
JENKINS_JOB_NAME=simple-repo-cli


API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173
API_BOOTSTRAP_DEMO=0
REQUIRE_REMOTE_EXECUTION_APPROVAL=0
ALLOW_UNAPPROVED_LOCAL_VALIDATION=1
REQUIRE_GITHUB_WRITE_APPROVAL=0

# 调查执行器：builtin 保留原循环；deepseek 需先安装 backend[harness] 或构建可选镜像。
# 下方为复盘调查配置；Compose 生产部署使用仓库根目录 .env.example。
# Writer/Embedding 的 OPENAI_*、CONTEXT_*、CODE_CONTEXT_* 完整配置也见根模板。
# 待审核通知必填：群成员可访问的工作台根地址，不含 /retrospective；API/Worker 使用同一值。
REVIEW_PUBLIC_BASE_URL=
REVIEW_INVESTIGATION_RUNNER=builtin
INSTALL_HARNESS=0
# 留空时复用 OPENAI 的模型、密钥与地址；Embedding 使用独立的 EMBEDDING_MODEL。
# 以下容量适用于已核验的 1M 路由；换小窗口模型时须同步降低选材/输出/余量预算。
REVIEW_HARNESS_MODEL=
REVIEW_HARNESS_API_KEY=
REVIEW_HARNESS_BASE_URL=
REVIEW_HARNESS_API=openai-completions
REVIEW_HARNESS_ROOT=runtime/harness
REVIEW_HARNESS_TIMEOUT_SECONDS=600
REVIEW_HARNESS_MODEL_TIMEOUT_SECONDS=120
REVIEW_HARNESS_MAX_ROUNDS=40
REVIEW_HARNESS_MAX_CALLS=80
REVIEW_HARNESS_TOOL_OUTPUT_CHARS=600000
REVIEW_HARNESS_TOOL_ITEM_CHARS=12000
REVIEW_HARNESS_INITIAL_CONTEXT_CHARS=160000
REVIEW_HARNESS_INITIAL_ITEM_CHARS=24000
REVIEW_HARNESS_REQUEST_MAX_BYTES=16000000
REVIEW_HARNESS_MAX_OUTPUT_TOKENS=4096
REVIEW_HARNESS_CONTEXT_TOKENS=1000000
# DSH 原生会话压缩；仅 deepseek + Chat Completions 生效。0 可回退关闭。
REVIEW_HARNESS_COMPACTION_ENABLED=1
REVIEW_HARNESS_COMPACTION_MAX_REQUESTS=4
REVIEW_HARNESS_COMPACTION_MAX_TOKENS=16384
REVIEW_HARNESS_COMPACTION_THRESHOLD=0.8
REVIEW_HARNESS_COMPACTION_HEADROOM=32768
