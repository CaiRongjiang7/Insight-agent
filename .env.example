POSTGRES_DB=review_agent
POSTGRES_USER=review_agent
POSTGRES_PASSWORD=change-me

OPENAI_API_KEY=
OPENAI_MODEL=deepseek-v4.1-flash-1017
# 百炼公共兼容地址可用；生产环境也可换成业务空间专属 compatible-mode/v1 地址。
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
OPENAI_TIMEOUT_SECONDS=120
# 留空不向提供商传参；支持 enable_thinking 的兼容模型可设 0/1。
OPENAI_ENABLE_THINKING=

GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_URL=https://api.github.com

FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_WIKI_SPACE_ID=
FEISHU_WIKI_PARENT_NODE_TOKEN=

RAG_TOP_K=5
RAG_CHANNEL_POOL=40
RAG_RRF_K=60
RAG_RERANK_POOL=20
LLM_MAX_RETRIES=2
CONTEXT_BUDGET_CHARS=600000
CONTEXT_ITEM_MAX_CHARS=60000
CODE_CONTEXT_ENABLED=1
# 旧版一次符号规划：仅关闭标准工具后可用；设 1 且有未解析方法时最多调用一次模型。
CODE_CONTEXT_PLANNER_ENABLED=0
# 标准只读取证工具循环，默认开启；设 0 关闭，开启时不叠加上方的一次规划。
REVIEW_TOOLS_ENABLED=1
CODE_CONTEXT_MAX_FILES=10
CODE_CONTEXT_MAX_EXPANDED_FILES=120
CODE_CONTEXT_MAX_REGIONS_PER_FILE=4
CODE_CONTEXT_MAX_SNIPPET_CHARS=12000
CODE_CONTEXT_MAX_ARCHIVE_BYTES=30000000

# 手工/PR 默认群；同时是 @机器人入口的允许群（逗号分隔，启用 listener 时不能为空）。
FEISHU_CHAT_IDS=
FEISHU_DOC_TOKENS=
# 待审核通知必须配置：群成员能访问的工作台根地址，不含 /retrospective；API/Worker 使用同一值。
REVIEW_PUBLIC_BASE_URL=
# @入口按需启动：docker compose --profile feishu-bot up -d feishu-bot

# 调查执行器：builtin 保留原循环；deepseek 需先安装 backend[harness] 或构建可选镜像。
REVIEW_INVESTIGATION_RUNNER=builtin
INSTALL_HARNESS=0
# 留空时复用 OPENAI 的模型、密钥与地址；Embedding 使用独立的 EMBEDDING_MODEL。
# 以下容量适用于已核验的 1M 路由；换小窗口模型时须同步降低选材/输出/余量预算。
REVIEW_HARNESS_MODEL=
REVIEW_HARNESS_API_KEY=
REVIEW_HARNESS_BASE_URL=
REVIEW_HARNESS_API=openai-completions
REVIEW_HARNESS_ROOT=runtime/harness
REVIEW_HARNESS_TIMEOUT_SECONDS=600
REVIEW_HARNESS_MODEL_TIMEOUT_SECONDS=120
REVIEW_HARNESS_MAX_ROUNDS=40
REVIEW_HARNESS_MAX_CALLS=80
REVIEW_HARNESS_TOOL_OUTPUT_CHARS=600000
REVIEW_HARNESS_TOOL_ITEM_CHARS=12000
REVIEW_HARNESS_INITIAL_CONTEXT_CHARS=160000
REVIEW_HARNESS_INITIAL_ITEM_CHARS=24000
REVIEW_HARNESS_REQUEST_MAX_BYTES=16000000
REVIEW_HARNESS_MAX_OUTPUT_TOKENS=4096
REVIEW_HARNESS_CONTEXT_TOKENS=1000000
# DSH 原生会话压缩；仅 deepseek + Chat Completions 生效。0 可回退关闭。
REVIEW_HARNESS_COMPACTION_ENABLED=1
REVIEW_HARNESS_COMPACTION_MAX_REQUESTS=4
REVIEW_HARNESS_COMPACTION_MAX_TOKENS=16384
REVIEW_HARNESS_COMPACTION_THRESHOLD=0.8
REVIEW_HARNESS_COMPACTION_HEADROOM=32768
